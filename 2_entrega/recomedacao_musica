CREATE (u)-[:LISTENED {count:x.c}]->(s);


MATCH (u:User)-[:LISTENED]->(s:Song)
WHERE rand() < 0.4
CREATE (u)-[:LIKED]->(s);

MATCH (u:User), (a:Artist)
WHERE rand() < 0.2
CREATE (u)-[:FOLLOWS]->(a);


**CÓDIGOS DE RECOMENDAÇÃO

-POR SIMILARIDADE DE USUÁRIOS

MATCH (u:User {name:"Ana"})-[:LISTENED]->(s:Song)<-[:LISTENED]-(other:User)
WHERE u <> other

WITH u, other, collect(s.id) AS commonSongs

MATCH (other)-[:LISTENED]->(rec:Song)
WHERE NOT (u)-[:LISTENED]->(rec)

RETURN
  rec.title AS recomendacao,
  size(commonSongs) AS score
ORDER BY score DESC
LIMIT 5;

-POR GÊNERO

MATCH (u:User {name:"Ana"})-[:LISTENED]->(:Song)-[:IN_GENRE]->(g:Genre)
WITH u, g, count(*) AS freq
ORDER BY freq DESC
LIMIT 1

MATCH (rec:Song)-[:IN_GENRE]->(g)
WHERE NOT (u)-[:LISTENED]->(rec)

RETURN rec.title, g.name;

-ENTRE USUÁRIOS (INTERSEÇÃO)

MATCH (u1:User)-[:LISTENED]->(s:Song)<-[:LISTENED]-(u2:User)
WHERE u1 <> u2

WITH u1, u2, collect(s.id) AS songs
RETURN
  u1.name,
  u2.name,
  size(apoc.coll.toSet(songs)) AS similarity
ORDER BY similarity DESC;

**CRIAÇÃO DAS MÚSICAS E SEUS RESPECTIVOS GÊNEROS 

UNWIND [
  {id:1, title:"Anti-Hero", artist:"Taylor Swift", genre:"Pop"},
  {id:2, title:"Blinding Lights", artist:"The Weeknd", genre:"Pop"},
  {id:3, title:"Yellow", artist:"Coldplay", genre:"Rock"},
  {id:4, title:"Viva La Vida", artist:"Coldplay", genre:"Rock"},
  {id:5, title:"Bad Guy", artist:"Billie Eilish", genre:"Alternative"},
  {id:6, title:"Happier Than Ever", artist:"Billie Eilish", genre:"Indie"},
  {id:7, title:"Get Lucky", artist:"Daft Punk", genre:"Electronic"},
  {id:8, title:"Instant Crush", artist:"Daft Punk", genre:"Electronic"},
  {id:9, title:"Starboy", artist:"The Weeknd", genre:"Pop"},
  {id:10, title:"Style", artist:"Taylor Swift", genre:"Pop"}
] AS s

MATCH (a:Artist {name:s.artist})
MATCH (g:Genre {name:s.genre})
CREATE (song:Song {id:s.id, title:s.title})
CREATE (a)-[:CREATED]->(song)
CREATE (song)-[:IN_GENRE]->(g);


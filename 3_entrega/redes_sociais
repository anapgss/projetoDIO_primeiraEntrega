- Qual post tem mais engajamento (curtidas + comentários)?

MATCH (p:Post)
OPTIONAL MATCH (p)<-[:LIKED]-()
WITH p, COUNT(*) AS curtidas
OPTIONAL MATCH (p)<-[:ON]-(:Comment)
WITH p, curtidas, COUNT(*) AS comentarios
RETURN p.id AS postId,
       p.content AS conteudo,
       curtidas,
       comentarios,
       (curtidas + comentarios) AS engajamentoTotal
ORDER BY engajamentoTotal DESC;



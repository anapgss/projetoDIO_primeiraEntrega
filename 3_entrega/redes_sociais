MATCH (u:User_name {name:"ana.silva"})-[:POSTED]->(:Post)-[:ABOUT]->(t:Topic)
MATCH (outro:User_name)-[:POSTED]->(:Post)-[:ABOUT]->(t)
WHERE u <> outro
  AND NOT (u)-[:FOLLOWS]->(outro)
